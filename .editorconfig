# EditorConfig - Standardize editor settings across the project
# See https://editorconfig.org for more information

root = true

# Default settings for all files
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Python files
[*.py]
indent_size = 4
max_line_length = 100
quote_type = single

# TypeScript files
[*.ts]
indent_size = 2
max_line_length = 120
quote_type = single
insert_final_newline = true

# TypeScript React files
[*.tsx]
indent_size = 2
max_line_length = 120
quote_type = single
insert_final_newline = true

# JavaScript files
[*.js]
indent_size = 2
max_line_length = 120
quote_type = single

# JSON files
[*.json]
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown files
[*.md]
trim_trailing_whitespace = true
insert_final_newline = true

# YAML files
[*.yml]
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# Dockerfile
[Dockerfile]
indent_style = tab

# Shell scripts
[*.sh]
indent_size = 2
end_of_line = lf

# Log files
[*.log]
trim_trailing_whitespace = false
insert_final_newline = false

# Binary files
[*.mp4]
trim_trailing_whitespace = false
insert_final_newline = false